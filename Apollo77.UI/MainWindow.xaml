<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Apollo77.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Apollo77.UI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    Title="Apollo77"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:components="using:Apollo77.UI.Controls" 
    xmlns:enum="using:Apollo77.UI.Enums" 
    mc:Ignorable="d">

    <SplitView IsPaneOpen="{x:Bind PaneOpenend, Mode=TwoWay}" 
               x:Name="splitView" 
               PaneBackground="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}"
               OpenPaneLength="250"
               CompactPaneLength="0" 
               DisplayMode="CompactInline"
               Padding="10">

        <SplitView.Background>
            <AcrylicBrush
                TintColor="#202020"
                TintOpacity="1"
                FallbackColor="#202020" />
        </SplitView.Background>

        <Border BorderThickness="7"
                BorderBrush="#303030">

            <Grid Padding="10">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Vertical">

                    <StackPanel Orientation="Vertical" Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Grid HorizontalAlignment="Stretch" Margin="0,0,0,10">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button Padding="10" Click="TogglePane_Click" Grid.Column="0">
                                <SymbolIcon Symbol="GlobalNavigationButton"/>
                            </Button>

                            <components:RunningProcessesInfo x:Name="RunningProcessesInfo"  Grid.Column="2" />

                        </Grid>

                        <TextBox x:Name="SearchBox" PlaceholderText="Search processes..." TextChanged="SearchBox_TextChanged" Margin="0,0,0,0" />
                    </StackPanel>

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>

                        <NavigationView x:Name="SelectorBar" 
                                    SelectionChanged="SelectorBar_SelectionChanged" 
                                    PaneDisplayMode="Top" 
                                    SelectionFollowsFocus="Enabled"
                                    IsBackButtonVisible="Collapsed"
                                    IsSettingsVisible="False"
                                    Grid.Column="0">
                            <NavigationView.MenuItems>
                                <NavigationViewItem x:Name="RunningProcessesTab" Tag="{x:Bind enum:ProcessCategory.RunningProcesses}"  ToolTipService.ToolTip="Running Processes" IsSelected="True" >
                                    <NavigationViewItem.Icon >
                                        <SymbolIcon Symbol="NewWindow" />
                                    </NavigationViewItem.Icon>
                                    <NavigationViewItem.InfoBadge>
                                        <InfoBadge Style="{StaticResource SuccessValueInfoBadgeStyle}" x:Name="infoBadge1" Value="{x:Bind ViewModel.GetNumberOfAllRunningProcesses()}" FontWeight="Light" Margin="-7, 0, 0, 0"/>
                                    </NavigationViewItem.InfoBadge>
                                </NavigationViewItem>
                                <NavigationViewItem  x:Name="ApplicationsTab" Tag="{x:Bind enum:ProcessCategory.Applications}"  ToolTipService.ToolTip="Applications" Icon="AllApps" >
                                    <NavigationViewItem.InfoBadge>
                                        <InfoBadge Style="{StaticResource SuccessValueInfoBadgeStyle}" x:Name="infoBadge2" Value="{x:Bind ViewModel.GetNumberOfApplications()}" FontWeight="Light" />
                                    </NavigationViewItem.InfoBadge>
                                </NavigationViewItem>
                            </NavigationView.MenuItems>

                        </NavigationView>

                        <CommandBar Grid.Column="1" Background="Transparent" IsOpen="False">
                            <CommandBar.SecondaryCommands>
                                <AppBarButton Icon="Sort" Label="Sort by Memory">
                                    <AppBarButton.KeyboardAccelerators>
                                        <KeyboardAccelerator Modifiers="Control" Key="M"/>
                                    </AppBarButton.KeyboardAccelerators>
                                </AppBarButton>
                                <AppBarButton Icon="Sort" Label="Sort by Threads">
                                    <AppBarButton.KeyboardAccelerators>
                                        <KeyboardAccelerator Modifiers="Control" Key="T" />
                                    </AppBarButton.KeyboardAccelerators>
                                </AppBarButton>
                                <AppBarButton Icon="Sort" Label="Sort by Icon">
                                    <AppBarButton.KeyboardAccelerators>
                                        <KeyboardAccelerator Modifiers="Control" Key="I" />
                                    </AppBarButton.KeyboardAccelerators>
                                </AppBarButton>
                            </CommandBar.SecondaryCommands>

                        </CommandBar>

                    </Grid>

                </StackPanel>

                <ScrollView Grid.Row="1" ContentOrientation="None" VerticalScrollBarVisibility="Auto" Height="auto">
                    <Frame x:Name="ContentFrame" IsNavigationStackEnabled="True" />
                </ScrollView>

            </Grid>

        </Border>

        <SplitView.Pane>

            <Border BorderThickness="7"
                    BorderBrush="#303030">

                <Border.Background>
                    <AcrylicBrush TintColor="#202020"
                                  TintOpacity="0.8"
                                  FallbackColor="#202020" />
                </Border.Background>

                <StackPanel Margin="0,10,0,0">

                    <Border CornerRadius="15" 
                            BorderThickness="1"
                            Padding="10" 
                            Margin="10,0,10,0"
                            BorderBrush="#303030">

                        <TextBlock Text="Actions" 
                                   Foreground="White" 
                                   FontSize="18" 
                                   VerticalAlignment="Center" 
                                   Grid.Column="0" />
                    </Border>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center" 
                                Margin="0,10,0,0" 
                                Spacing="10">

                        <Button HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MinWidth="100" Width="Auto"
                                Padding="20">
                            <ToolTipService.ToolTip>
                                <ToolTip Content="Refresh" />
                            </ToolTipService.ToolTip>
                            <SymbolIcon Symbol="Refresh"/>
                        </Button>

                        <Button HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MinWidth="100" Width="Auto"
                                Padding="20"
                                Click="AddProcess_Click">
                            <ToolTipService.ToolTip>
                                <ToolTip Content="Add new process" />
                            </ToolTipService.ToolTip>
                            <SymbolIcon Symbol="Add"/>
                        </Button>

                    </StackPanel>

                </StackPanel>

            </Border>

        </SplitView.Pane>

    </SplitView>

</Window>