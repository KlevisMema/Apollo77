<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Apollo77.UI.Controls.ProcessesViewControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Apollo77.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ListBox x:Name="ProcessListBox"
                    ItemsSource="{x:Bind ViewModel.Processes, Mode=TwoWay}"
                    Background="#33000000"
                    BorderBrush="#66000000"
                    BorderThickness="1"
                    MinWidth="200"
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Stretch"
                    SelectionChanged="ProcessListBox_SelectionChanged">

        <ListBox.ItemTemplate>

            <DataTemplate>
                <StackPanel Orientation="Vertical" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{Binding Icon}" Width="32" Height="32" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding Name}" FontSize="16" Margin="0,0,10,0" />
                        <TextBlock Text="(ID: " FontSize="16" />
                        <TextBlock Text="{Binding Id}" FontSize="16" />
                        <TextBlock Text=")" FontSize="16" />
                    </StackPanel>
                    <TextBlock FontSize="14" Foreground="Gray">
                        <Run Text="Memory: " />
                        <Run Text="{Binding MemoryUsage}" />
                        <Run Text="MB" />
                    </TextBlock>
                    <TextBlock FontSize="14" Foreground="Gray">
                        <Run Text="CPU Time: " />
                        <Run Text="{Binding CpuTime}" />
                    </TextBlock>
                    <TextBlock FontSize="14" Foreground="Gray">
                        <Run Text="Threads: " />
                        <Run Text="{Binding ThreadsCount}" />
                    </TextBlock>
                    <TextBlock FontSize="14" Foreground="Gray">
                        <Run Text="Start Time: " />
                        <Run Text="{Binding StartTime}" />
                    </TextBlock>
                </StackPanel>
            </DataTemplate>

        </ListBox.ItemTemplate>

    </ListBox>

</UserControl>